{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pagination",
  "type": "object",
  "properties": {
    "page": {
      "type": "integer",
      "minimum": 0,
      "format": "uint32"
    },
    "per_page": {
      "type": "integer",
      "minimum": 0,
      "format": "uint32"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "format": "uint32"
    }
  },
  "required": [
    "page",
    "per_page",
    "total"
  ]
}