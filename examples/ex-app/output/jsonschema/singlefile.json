{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AdjacentlyTagged": {
      "title": "AdjacentlyTagged",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "UnitVariant"
            }
          },
          "required": [
            "t"
          ]
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "WithData"
            },
            "c": {
              "type": "string"
            }
          },
          "required": [
            "t",
            "c"
          ]
        },
        {
          "type": "object",
          "properties": {
            "t": {
              "const": "WithStruct"
            },
            "c": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "format": "int32"
                },
                "y": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "required": [
                "x",
                "y"
              ]
            }
          },
          "required": [
            "t",
            "c"
          ]
        }
      ]
    },
    "AppConfig": {
      "title": "AppConfig",
      "type": "object",
      "properties": {
        "app_name": {
          "type": "string"
        },
        "debug": {
          "type": "boolean"
        }
      },
      "required": [
        "app_name",
        "debug"
      ]
    },
    "CreateUserRequest": {
      "title": "CreateUserRequest",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "permission": {
          "$ref": "#/$defs/Permission"
        }
      },
      "required": [
        "name",
        "email",
        "role",
        "permission"
      ]
    },
    "Pagination": {
      "title": "Pagination",
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 0,
          "format": "uint32"
        },
        "per_page": {
          "type": "integer",
          "minimum": 0,
          "format": "uint32"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "format": "uint32"
        }
      },
      "required": [
        "page",
        "per_page",
        "total"
      ]
    },
    "Permission": {
      "title": "Permission",
      "const": "read_all"
    },
    "Role": {
      "title": "Role",
      "enum": [
        "Admin",
        "Member",
        "Guest"
      ]
    },
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/UserId"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "role"
      ]
    },
    "UserId": {
      "title": "UserId",
      "type": "integer",
      "minimum": 0,
      "format": "uint32"
    },
    "UserListResponse": {
      "title": "UserListResponse",
      "type": "object",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/User"
          }
        },
        "pagination": {
          "$ref": "#/$defs/Pagination"
        }
      },
      "required": [
        "users",
        "pagination"
      ]
    }
  }
}